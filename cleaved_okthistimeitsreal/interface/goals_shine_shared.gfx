spriteTypes = {	
	
	SpriteType = {
		name = "GFX_focus_restorationism_realized_big_shine"
		texturefile = "gfx/interface/goals/shared/focus_restorationism_realized_big.dds"
				effectFile = "gfx/FX/buttonstate.lua"
		animation = {
			animationmaskfile = "gfx/interface/goals/shared/focus_restorationism_realized_big.dds"
			animationtexturefile = "gfx/interface/goals/shine_overlay.dds" 	# <- the animated file
			animationrotation = -90.0		# -90 clockwise 90 counterclockwise(by default)
